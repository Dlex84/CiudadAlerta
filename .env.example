# Copia este archivo a .env (no se sube a Git). Node lo lee con --env-file-if-exists.

# --- Base de datos (docker compose up -d db) ---
DATABASE_URL=postgres://ciudadalerta:ciudadalerta@localhost:5432/ciudadalerta

# --- API ---
PORT=3000
NODE_ENV=development
# URL pública del frontend (se usa en los enlaces de los correos y para validar el origen)
APP_URL=http://localhost:5173
# Si la app corre en HTTPS (producción) deja COOKIE_SECURE=true
COOKIE_SECURE=false
# Detrás de Nginx/Traefik: true para registrar la IP real del cliente (X-Forwarded-For)
TRUST_PROXY=false

# --- Sesión y enlaces (HU-1.1, HU-1.5) ---
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72
# Intentos permitidos por IP en login/registro/recuperación dentro de la ventana
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=15

# --- Correo ---
# Sin SMTP_HOST los correos se imprimen en consola. Con `docker compose up -d mailpit`:
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CiudadAlerta <no-reply@ciudadalerta.local>

# --- Archivos ---
UPLOADS_DIR=./uploads

# --- Primer Super Administrador (npm run db:seed). Cambia la contraseña. ---
SEED_ADMIN_NAME=Super Administrador
SEED_ADMIN_EMAIL=admin@ciudadalerta.local
SEED_ADMIN_PASSWORD=CambiaEstaClave-123
